Q.NO - 806
Q.NAME -  Number of Lines To Write String
LEVEL - EASY 

class Solution {
    public int[] numberOfLines(int[] widths, String S) {
        int lines = 1, width = 0;
        for (char c: S.toCharArray()) {
            int w = widths[c - 'a'];
            width += w;
            if (width > 100) {
                lines++;
                width = w;
            }
        }

        return new int[]{lines, width};
    }
}
Q.NO - 1122
Q.NAME - RELATIVE SORT ARRAY
LEVEL- EASY

class Solution {
    public int[] relativeSortArray(int[] arr1, int[] arr2) {
        int[] count = new int[1001];

        for (int x : arr1)
            count[x]++;

        int k = 0;

        for (int x : arr2) {
            while (count[x]-- > 0)
                arr1[k++] = x;
        }

        for (int i = 0; i < 1001; i++) {
            while (count[i]-- > 0)
                arr1[k++] = i;
        }

        return arr1;
    }
}
