Q.NO -2574
Q.NAME - LEFT AND RIGHT SUM DIFFERENCES
DIFFICULTY LEVEL- EASY

class Solution {

    public int[] leftRightDifference(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];

        int leftSum = 0;
        for (int i = 0; i < n; ++i) {
            ans[i] = leftSum;
            leftSum += nums[i];
        }

        int rightSum = 0;
        for (int i = n - 1; i >= 0; --i) {
            ans[i] = Math.abs(ans[i] - rightSum);
            rightSum += nums[i];
        }

        return ans;
    }
}

Q.NO - 3432
Q.NAME - COUNT PARTITIONS WITH EVEN SUM DIFFERENCES 
DIFFICULTY LEVEL - EASY

class Solution {

    public int countPartitions(int[] nums) {
        int totalSum = 0;
        for (int x : nums) {
            totalSum += x;
        }
        return totalSum % 2 == 0 ? nums.length - 1 : 0;
    }
}
