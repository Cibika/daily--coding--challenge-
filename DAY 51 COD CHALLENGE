Q.NO - 374
Q.NAME - GUESS NUMBER HIGHER OR LOWER
LEVEL - EASY

public class Solution extends GuessGame {
    public int guessNumber(int n) {
        int l = 1, r = n;

        while (l <= r) {
            int mid = l + (r - l) / 2;
            
            if (guess(mid) == 0)
                return mid;
            else if (guess(mid) < 0)
                r = mid - 1;
            else
                l = mid + 1;
        }
        return -1;
    }
}
