594- LONGEST HARMONIOUUS SUBSEQUENCE
  EASY
  import java.util.*;

class Solution {
    public int findLHS(int[] nums) {
        HashMap<Integer,Integer> m = new HashMap<>();
        for(int x : nums)
            m.put(x, m.getOrDefault(x,0)+1);

        int ans = 0;
        for(int x : m.keySet())
            if(m.containsKey(x+1))
                ans = Math.max(ans, m.get(x)+m.get(x+1));

        return ans;
    }
}
645- SETMISMATCH
  EASY
  class Solution {
    public int[] findErrorNums(int[] nums) {
        int[] c = new int[nums.length+1];

        for(int x : nums) c[x]++;

        int d=0, m=0;
        for(int i=1;i<c.length;i++) {
            if(c[i]==2) d=i;
            if(c[i]==0) m=i;
        }

        return new int[]{d,m};
    }
}
