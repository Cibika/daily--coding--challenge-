Q.NO - 292
Q.NAME - NIM GAME
LEVEL - EASY

class Solution {
    public boolean canWinNim(int n) {
        return n % 4 != 0;
    }
}

Q.NO - 342
Q.NAME - POWER OF FOUR
LEVEL - EASY

class Solution {
    public boolean isPowerOfFour(int n) {
        return n > 0 && (n & (n - 1)) == 0 && (n & 0x55555555) != 0;
    }
}
