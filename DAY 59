Q.NO - 1365
Q.NAME - HOW MANY NUMBERS ARE SMALLER TYHAN THE CURRENT NUMBER
LEVEL - MED
class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
        int[] ans = new int[nums.length];
        for (int i = 0; i < nums.length; i++)
            for (int j = 0; j < nums.length; j++)
                if (nums[j] < nums[i]) ans[i]++;
        return ans;
    }
}
Q.NO - 1929
Q.NAME - CONCATENATION OF ARRAYS
LEVEL -MED
class Solution {
    public int[] getConcatenation(int[] nums) {
        int n = nums.length;
        int[] ans = new int[2 * n];

        for (int i = 0; i < n; i++) {
            ans[i] = nums[i];
            ans[i + n] = nums[i];
        }

        return ans;
    }
}
