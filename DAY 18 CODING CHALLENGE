Q.NO 198 
Q.NAME - HOUSE ROBBER
DIFFICULTY LEVEL - MEDIUM

class Solution {
    public int rob(int[] nums) {
        int prev1 = 0;
        int prev2 = 0;

        for (int num : nums) {
            int temp = Math.max(prev1, prev2 + num);
            prev2 = prev1;
            prev1 = temp;
        }

        return prev1;
    }
}
Q.NO - 231
Q.NAME - POWER OF TWO
DIFFICULTY LEVEL- EASY

class Solution {
    public boolean isPowerOfTwo(int n) {
        return n > 0 && (n & (n - 1)) == 0;
    }
}
