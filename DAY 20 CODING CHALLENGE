Q.NO-191
Q.NAME- NUMBER OF 1 BITS
LEVEL - EASY

class Solution {
    public int reverseBits(int n) {
        int result = 0;

        for (int i = 0; i < 32; i++) {
            result <<= 1;          // Shift result left
            result |= (n & 1);     // Copy last bit of n
            n >>>= 1;              // Unsigned right shift n
        }

        return result;
    }
}
